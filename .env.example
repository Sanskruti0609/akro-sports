# Copy this file to .env and fill in your values. Restart the server after changes.
PORT=3000

# WhatsApp orders: country code + number, digits only (India example: 919876543210)
WHATSAPP_NUMBER=910000000000

# Admin page (/admin.html) password
ADMIN_KEY=change-me

# Razorpay (UPI / cards / netbanking). Leave blank to hide the online-payment option.
# Get keys from dashboard.razorpay.com (use test keys first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Pricing rules (INR)
FREE_SHIPPING_OVER=1999
SHIPPING_FEE=99
COD_FEE=50
CUSTOM_PRINT_FEE=299
